    "Config has been moved. The feed database will be migrated to the new location the next time BlindRSS starts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration wurde verschoben. Die Feed-Datenbank wird beim nächsten Start von BlindRSS an den neuen Ort migriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración se ha movido. La base de datos de fuentes se migrará a la nueva ubicación la próxima vez que se inicie BlindRSS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration a été déplacée. La base de données des flux sera migrée vers le nouvel emplacement au prochain démarrage de BlindRSS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िग स्थानांतरित कर दिया गया है। अगली बार जब BlindRSS शुरू होगा तो फ़ीड डेटाबेस को नए स्थान पर माइग्रेट किया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione è stata spostata. Il database dei feed verrà migrato nella nuova posizione al prossimo avvio di BlindRSS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が移動されました。次回 BlindRSS を起動する際に、フィードデータベースが新しい場所に移行されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuratie is verplaatst. De feeddatabase wordt naar de nieuwe locatie gemigreerd de volgende keer dat BlindRSS start."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuratie is verplaatst. De feeddatabase wordt naar de nieuwe locatie gemigreerd de volgende keer dat BlindRSS start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja została przeniesiona. Baza danych kanałów zostanie zmigrowana do nowej lokalizacji przy następnym uruchomieniu BlindRSS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração foi movida. O banco de dados de feeds será migrado para o novo local na próxima vez que o BlindRSS for iniciado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração foi movida. A base de dados de feeds será migrada para o novo local na próxima vez que o BlindRSS iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация была изменена. База данных каналов будет перенесена в новое местоположение при следующем запуске BlindRSS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurationen har flyttats. Flödesdatabasen migreras till den nya platsen nästa gång BlindRSS startar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已移动。下次启动 BlindRSS 时,订阅源数据库将迁移到新位置。"
          }
        },
        "zh-Hant": {
