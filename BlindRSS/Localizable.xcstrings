      }
    },
    "Rich full-text view: show links, embedded videos, and tweets in a web view (instead of plain text). Falls back to plain text if unavailable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich-Volltextansicht: Links, eingebettete Videos und Tweets in einer Webansicht anzeigen (statt als reiner Text). Wechselt zu reinem Text, wenn nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de texto completo enriquecida: mostrar enlaces, vídeos incrustados y tuits en una vista web (en lugar de texto sin formato). Usa texto sin formato si no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue en texte intégral enrichie : afficher les liens, les vidéos intégrées et les tweets dans une vue web (au lieu du texte brut). Bascule vers le texte brut si indisponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिच पूर्ण-पाठ दृश्य: सादे पाठ के बजाय लिंक, एम्बेडेड वीडियो और ट्वीट को वेब दृश्य में दिखाएँ। उपलब्ध न होने पर सादे पाठ पर वापस लौटता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista testo completo avanzata: mostra collegamenti, video incorporati e tweet in una vista web (anziché come testo semplice). Ripiega sul testo semplice se non disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リッチ全文表示: リンク、埋め込み動画、ツイートを（プレーンテキストではなく）Web ビューで表示します。利用できない場合はプレーンテキストに切り替わります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgebreide volledige-tekstweergave: koppelingen, ingesloten video’s en tweets tonen in een webweergave (in plaats van platte tekst). Valt terug op platte tekst indien niet beschikbaar."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgebreide volledige-tekstweergave: koppelingen, ingesloten video’s en tweets tonen in een webweergave (in plaats van platte tekst). Valt terug op platte tekst indien niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzbogacony widok pełnego tekstu: pokazuj łącza, osadzone filmy i tweety w widoku sieciowym (zamiast zwykłego tekstu). W razie niedostępności wraca do zwykłego tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualização de texto completo avançada: mostrar links, vídeos incorporados e tweets em uma exibição web (em vez de texto simples). Retorna ao texto simples se indisponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de texto completo enriquecida: mostrar ligações, vídeos incorporados e tweets numa vista web (em vez de texto simples). Recorre ao texto simples se não estiver disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширенный просмотр полного текста: показывать ссылки, встроенные видео и твиты в веб-представлении (вместо обычного текста). При недоступности возвращается к обычному тексту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikad fulltextvy: visa länkar, inbäddade videoklipp och tweets i en webbvy (i stället för oformaterad text). Återgår till oformaterad text om den inte är tillgänglig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "富全文视图：在网页视图中显示链接、嵌入的视频和推文（而非纯文本）。不可用时回退到纯文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豐富全文檢視：在網頁檢視中顯示連結、嵌入的影片和推文（而非純文字）。無法使用時會回復為純文字。"
          }
        }
      }
    },
    "Include image alt text in articles (announces images, can override per feed)": {
      "localizations": {
        "de": {
          "stringUnit": {
