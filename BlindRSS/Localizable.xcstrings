    "Show links as \"text (address)\" and open the link at the cursor with Enter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links als \"Text (Adresse)\" anzeigen und den Link an der Cursorposition mit der Eingabetaste öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar los enlaces como \"texto (dirección)\" y abrir el enlace situado en el cursor con Intro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les liens sous la forme « texte (adresse) » et ouvrir le lien situé sous le curseur avec Entrée"
          }
        },
        "hi": {
          "stringUnit": {
