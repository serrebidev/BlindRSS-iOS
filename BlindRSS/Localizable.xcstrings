    "Choose where to add BlindRSS shortcuts.\nTaskbar pinning may be limited by your Windows version/policies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wo BlindRSS-Verknüpfungen hinzugefügt werden sollen.\nDas Anheften an die Taskleiste kann durch Ihre Windows-Version/Richtlinien eingeschränkt sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija dónde agregar los accesos directos de BlindRSS.\nEl anclaje a la barra de tareas puede estar limitado por su versión o directivas de Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où ajouter les raccourcis BlindRSS.\nL'épinglage à la barre des tâches peut être limité par votre version de Windows ou vos stratégies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि BlindRSS शॉर्टकट कहाँ जोड़े जाएँ।\nटास्कबार पर पिन करना आपके Windows संस्करण/नीतियों द्वारा सीमित हो सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove aggiungere i collegamenti di BlindRSS.\nL'aggiunta alla barra delle applicazioni può essere limitata dalla versione o dai criteri di Windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BlindRSS のショートカットを追加する場所を選択してください。\nタスクバーへのピン留めは、Windows のバージョンやポリシーによって制限される場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar BlindRSS-snelkoppelingen moeten worden toegevoegd.\nVastmaken aan de taakbalk kan beperkt zijn door uw Windows-versie of beleidsregels."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar BlindRSS-snelkoppelingen moeten worden toegevoegd.\nVastmaken aan de taakbalk kan beperkt zijn door uw Windows-versie of beleidsregels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, gdzie dodać skróty BlindRSS.\nPrzypinanie do paska zadań może być ograniczone przez wersję systemu Windows lub zasady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde adicionar os atalhos do BlindRSS.\nFixar na barra de tarefas pode ser limitado pela sua versão ou políticas do Windows."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde adicionar os atalhos do BlindRSS.\nAfixar na barra de tarefas pode ser limitado pela sua versão ou políticas do Windows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, куда добавить ярлыки BlindRSS.\nЗакрепление на панели задач может быть ограничено вашей версией Windows или политиками."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj var BlindRSS-genvägar ska läggas till.\nFastnålning i aktivitetsfältet kan begränsas av din Windows-version/dina principer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择在何处添加 BlindRSS 快捷方式。\n固定到任务栏可能受您的 Windows 版本/策略限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要在何處加入 BlindRSS 捷徑。\n釘選到工作列可能受您的 Windows 版本/原則限制。"
          }
        }
      }
    },
