    "Failed to download update metadata. GitHub may be temporarily unavailable; please try again in a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update-Metadaten konnten nicht heruntergeladen werden. GitHub ist möglicherweise vorübergehend nicht erreichbar; bitte versuchen Sie es in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron descargar los metadatos de la actualización. Es posible que GitHub no esté disponible temporalmente; inténtelo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement des métadonnées de la mise à jour. GitHub est peut-être temporairement indisponible ; veuillez réessayer dans quelques minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट मेटाडेटा डाउनलोड करने में विफल। GitHub अस्थायी रूप से अनुपलब्ध हो सकता है; कृपया कुछ मिनटों में फिर से प्रयास करें।"
          }
