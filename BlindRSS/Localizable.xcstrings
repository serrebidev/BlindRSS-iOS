    "Leave a path blank to auto-detect. A set path overrides detection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie einen Pfad leer, um ihn automatisch zu erkennen. Ein festgelegter Pfad überschreibt die Erkennung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje una ruta en blanco para detectarla automáticamente. Una ruta establecida anula la detección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez un chemin vide pour la détection automatique. Un chemin défini remplace la détection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतः-पहचान के लिए पथ खाली छोड़ें। सेट किया गया पथ पहचान को ओवरराइड करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia un percorso vuoto per il rilevamento automatico. Un percorso impostato sovrascrive il rilevamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出するにはパスを空欄にしてください。パスを設定すると自動検出より優先されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een pad leeg om automatisch te detecteren. Een ingesteld pad overschrijft detectie."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een pad leeg om automatisch te detecteren. Een ingesteld pad overschrijft detectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw ścieżkę pustą, aby wykryć automatycznie. Ustawiona ścieżka nadpisuje wykrywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe um caminho em branco para detectar automaticamente. Um caminho definido substitui a detecção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe um caminho em branco para detetar automaticamente. Um caminho definido substitui a deteção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте путь пустым для автоматического обнаружения. Заданный путь переопределяет обнаружение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna en sökväg tom för att detektera automatiskt. En angiven sökväg åsidosätter detekteringen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空路径以自动检测。设置路径将覆盖自动检测。"
