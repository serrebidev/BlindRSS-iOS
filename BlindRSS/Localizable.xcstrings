    "No recent YouTube cookies.txt export was found in your Downloads.\n\nExport one with the extension first, or choose the file manually.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Ihren Downloads wurde kein aktueller YouTube-cookies.txt-Export gefunden.\n\nExportieren Sie zuerst einen mit der Erweiterung oder wählen Sie die Datei manuell aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna exportación reciente de cookies.txt de YouTube en su carpeta de descargas.\n\nExporte una primero con la extensión o elija el archivo manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun export récent de cookies.txt YouTube n'a été trouvé dans vos téléchargements.\n\nExportez-en un avec l'extension d'abord, ou choisissez le fichier manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डाउनलोड में YouTube cookies.txt का कोई हालिया निर्यात नहीं मिला।\n\nपहले एक्सटेंशन से एक निर्यात करें, या फ़ाइल स्वयं चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna esportazione recente di cookies.txt di YouTube trovata nei tuoi download.\n\nEsportane una con l'estensione oppure scegli il file manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の YouTube cookies.txt のエクスポートがダウンロードフォルダーに見つかりませんでした。\n\n先に拡張機能でエクスポートするか、ファイルを手動で選択してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen recente YouTube-cookies.txt-export gevonden in uw downloads.\n\nExporteer er eerst een met de extensie of kies het bestand handmatig."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen recente YouTube-cookies.txt-export gevonden in uw downloads.\n\nExporteer er eerst een met de extensie of kies het bestand handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono niedawnego eksportu pliku cookies.txt YouTube w folderze pobranych.\n\nNajpierw wyeksportuj go za pomocą rozszerzenia lub wybierz plik ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma exportação recente de cookies.txt do YouTube foi encontrada em seus downloads.\n\nExporte uma com a extensão primeiro ou escolha o arquivo manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrada nenhuma exportação recente de cookies.txt do YouTube nas suas transferências.\n\nExporte uma primeiro com a extensão ou escolha o ficheiro manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ваших загрузках не найден ни один недавно экспортированный cookies.txt от YouTube.\n\nСначала экспортируйте его при помощи расширения, или выберите файл вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ny YouTube-cookies.txt-export hittades bland dina nedladdningar.\n\nExportera en med tillägget först, eller välj filen manuellt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的下载文件夹中未找到最近导出的 YouTube cookies.txt。\n\n请先用该扩展导出一个，或手动选择文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的下載資料夾中找不到最近匯出的 YouTube cookies.txt。\n\n請先用該擴充功能匯出一個，或手動選擇檔案。"
          }
        }
      }
    },
