    "Grok is by xAI. Get a key at console.x.ai. For Groq (LLaMA/Mistral), select 'Groq (LLaMA, Mistral)' instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok stammt von xAI. Holen Sie sich einen Schlüssel unter console.x.ai. Für Groq (LLaMA/Mistral) wählen Sie stattdessen „Groq (LLaMA, Mistral)“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok es de xAI. Obtenga una clave en console.x.ai. Para Groq (LLaMA/Mistral), seleccione en su lugar 'Groq (LLaMA, Mistral)'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok est développé par xAI. Obtenez une clé sur console.x.ai. Pour Groq (LLaMA/Mistral), sélectionnez plutôt « Groq (LLaMA, Mistral) »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok xAI द्वारा है। console.x.ai पर एक कुंजी प्राप्त करें। Groq (LLaMA/Mistral) के लिए, इसके बजाय 'Groq (LLaMA, Mistral)' चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok è di xAI. Ottieni una chiave su console.x.ai. Per Groq (LLaMA/Mistral), seleziona invece 'Groq (LLaMA, Mistral)'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok は xAI が提供しています。console.x.ai でキーを取得してください。Groq(LLaMA/Mistral)を使う場合は、代わりに「Groq (LLaMA, Mistral)」を選択してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok is van xAI. Haal een sleutel op via console.x.ai. Selecteer voor Groq (LLaMA/Mistral) in plaats daarvan 'Groq (LLaMA, Mistral)'."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok is van xAI. Haal een sleutel op via console.x.ai. Selecteer voor Groq (LLaMA/Mistral) in plaats daarvan 'Groq (LLaMA, Mistral)'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok jest dostarczany przez xAI. Uzyskaj klucz na console.x.ai. Aby użyć Groq (LLaMA/Mistral), wybierz zamiast tego „Groq (LLaMA, Mistral)”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Grok é da xAI. Obtenha uma chave em console.x.ai. Para o Groq (LLaMA/Mistral), selecione 'Groq (LLaMA, Mistral)' em vez disso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Grok é da xAI. Obtenha uma chave em console.x.ai. Para o Groq (LLaMA/Mistral), selecione antes 'Groq (LLaMA, Mistral)'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok от xAI. Получите ключ по адресу console.x.ai. Для Groq (LLaMA/Mistral) выберите вместо этого \"Groq (LLaMA, Mistral)\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok kommer från xAI. Skaffa en nyckel på console.x.ai. För Groq (LLaMA/Mistral), välj i stället 'Groq (LLaMA, Mistral)'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok 由 xAI 提供。请在 console.x.ai 获取密钥。如需使用 Groq(LLaMA/Mistral),请改为选择“Groq (LLaMA, Mistral)”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok 由 xAI 提供。請在 console.x.ai 取得金鑰。如需使用 Groq(LLaMA/Mistral),請改選「Groq (LLaMA, Mistral)」。"
          }
        }
      }
    },
    "Groq is NOT Grok. Get a free Groq key at console.groq.com/keys (runs LLaMA and Mistral models).": {
