    "Would you like to install them automatically via Homebrew?\n\nTip: You can disable this prompt in Settings > YouTube.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie sie automatisch über Homebrew installieren?\n\nTipp: Sie können diese Abfrage unter Einstellungen > YouTube deaktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desea instalarlos automáticamente mediante Homebrew?\n\nConsejo: puede desactivar este aviso en Configuración > YouTube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous les installer automatiquement via Homebrew ?\n\nAstuce : vous pouvez désactiver cette invite dans Paramètres > YouTube."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप उन्हें Homebrew के माध्यम से स्वचालित रूप से इंस्टॉल करना चाहते हैं?\n\nसुझाव: आप इस संकेत को सेटिंग्स > YouTube में अक्षम कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi installarli automaticamente tramite Homebrew?\n\nSuggerimento: puoi disattivare questa richiesta in Impostazioni > YouTube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew を使って自動的にインストールしますか?\n\nヒント: この確認は 設定 > YouTube で無効にできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u ze automatisch installeren via Homebrew?\n\nTip: u kunt deze vraag uitschakelen in Instellingen > YouTube."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u ze automatisch installeren via Homebrew?\n\nTip: u kunt deze vraag uitschakelen in Instellingen > YouTube."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz zainstalować je automatycznie za pomocą Homebrew?\n\nWskazówka: to pytanie możesz wyłączyć w Ustawienia > YouTube."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseja instalá-los automaticamente via Homebrew?\n\nDica: você pode desativar este aviso em Configurações > YouTube."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretende instalá-los automaticamente através do Homebrew?\n\nSugestão: pode desativar este aviso em Definições > YouTube."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите установить их автоматически через Homebrew?\n\nСовет: вы можете отключить этот запрос в \"Настройки\" > \"YouTube\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du installera dem automatiskt via Homebrew?\n\nTips: du kan inaktivera den här frågan i Inställningar > YouTube."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要通过 Homebrew 自动安装它们吗?\n\n提示：您可以在“设置 > YouTube”中禁用此提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
