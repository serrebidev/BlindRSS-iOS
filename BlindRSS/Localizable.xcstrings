    "Remove this category? Feeds will be moved to Uncategorized.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kategorie entfernen? Feeds werden nach \"Nicht kategorisiert\" verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar esta categoría? Las fuentes se moverán a \"Sin categoría\"."
