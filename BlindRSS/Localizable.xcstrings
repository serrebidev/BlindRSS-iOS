    "Direct media links are always saved in their original format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte Medienlinks werden immer in ihrem Originalformat gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces multimedia directos siempre se guardan en su formato original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens multimédias directs sont toujours enregistrés dans leur format d'origine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे मीडिया लिंक हमेशा उनके मूल प्रारूप में सहेजे जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I collegamenti multimediali diretti vengono sempre salvati nel loro formato originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接のメディアリンクは常に元の形式で保存されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Directe medialinks worden altijd in hun oorspronkelijke indeling opgeslagen."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Directe medialinks worden altijd in hun oorspronkelijke indeling opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośrednie linki multimedialne są zawsze zapisywane w oryginalnym formacie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links de mídia diretos são sempre salvos em seu formato original."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As ligações de multimédia diretas são sempre guardadas no formato original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямые ссылки на мультимедиа всегда сохраняются в исходном формате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkta medialänkar sparas alltid i sitt ursprungliga format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接媒体链接始终以其原始格式保存。"
          }
        },
