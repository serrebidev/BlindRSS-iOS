            "value": "No se pudo descargar la actualización: {error}. Es posible que GitHub no esté disponible temporalmente; inténtelo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement de la mise à jour : {error}. GitHub est peut-être temporairement indisponible ; veuillez réessayer dans quelques minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट डाउनलोड करने में विफल: {error}। GitHub अस्थायी रूप से अनुपलब्ध हो सकता है; कृपया कुछ मिनटों में फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare l'aggiornamento: {error}. GitHub potrebbe essere temporaneamente non disponibile; riprova tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートをダウンロードできませんでした: {error}。GitHub が一時的に利用できない可能性があります。数分後にもう一度お試しください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan update niet downloaden: {error}. GitHub is mogelijk tijdelijk niet bereikbaar; probeer het over een paar minuten opnieuw."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan update niet downloaden: {error}. GitHub is mogelijk tijdelijk niet bereikbaar; probeer het over een paar minuten opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać aktualizacji: {error}. GitHub może być chwilowo niedostępny; spróbuj ponownie za kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao baixar a atualização: {error}. O GitHub pode estar temporariamente indisponível; tente novamente em alguns minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao transferir a atualização: {error}. O GitHub pode estar temporariamente indisponível; tente novamente dentro de alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить обновление: {error}. Возможно, GitHub временно недоступен; повторите попытку через несколько минут."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att ladda ner uppdateringen: {error}. GitHub kan vara tillfälligt otillgängligt; försök igen om några minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载更新：{error}。GitHub 可能暂时不可用，请过几分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載更新：{error}。GitHub 可能暫時無法使用，請過幾分鐘後再試。"
          }
        }
      }
    },
