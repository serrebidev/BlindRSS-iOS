    "Read cookies directly from installed browsers (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium and their beta/nightly variants). Chrome/Edge/Brave need a one-time Windows permission prompt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies direkt aus installierten Browsern lesen (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium und deren Beta-/Nightly-Varianten). Chrome/Edge/Brave benötigen eine einmalige Windows-Berechtigungsabfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer cookies directamente desde los navegadores instalados (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium y sus variantes beta/nightly). Chrome/Edge/Brave necesitan un único aviso de permisos de Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire les cookies directement depuis les navigateurs installés (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium et leurs variantes bêta/nightly). Chrome/Edge/Brave nécessitent une autorisation Windows ponctuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थापित ब्राउज़रों (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium और उनके बीटा/नाइटली संस्करण) से सीधे कुकीज़ पढ़ें। Chrome/Edge/Brave को एक बार Windows अनुमति संकेत की आवश्यकता होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi i cookie direttamente dai browser installati (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium e relative varianti beta/nightly). Chrome/Edge/Brave richiedono una singola richiesta di autorizzazione di Windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのブラウザー (Firefox、Chrome、Edge、Brave、Opera、Vivaldi、Chromium とそのベータ版/ナイトリー版) から直接 Cookie を読み取ります。Chrome/Edge/Brave では、Windows のアクセス許可の確認が 1 回だけ必要です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies rechtstreeks lezen uit geïnstalleerde browsers (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium en hun bèta-/nightly-varianten). Chrome/Edge/Brave vragen eenmalig om Windows-toestemming."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies rechtstreeks lezen uit geïnstalleerde browsers (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium en hun bèta-/nightly-varianten). Chrome/Edge/Brave vragen eenmalig om Windows-toestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuj pliki cookie bezpośrednio z zainstalowanych przeglądarek (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium oraz ich wariantów beta/nightly). Chrome/Edge/Brave wymagają jednorazowego monitu o uprawnienia w systemie Windows."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler cookies diretamente dos navegadores instalados (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium e suas variantes beta/nightly). Chrome/Edge/Brave precisam de um único aviso de permissão do Windows."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler cookies diretamente a partir dos navegadores instalados (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium e respetivas variantes beta/nightly). Chrome/Edge/Brave precisam de uma única solicitação de permissão do Windows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать cookie напрямую из установленных браузеров (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium и их бета-/nightly-версий). Chrome/Edge/Brave требуют однократного запроса разрешения Windows."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs cookies direkt från installerade webbläsare (Firefox, Chrome, Edge, Brave, Opera, Vivaldi, Chromium och deras beta-/nightly-varianter). Chrome/Edge/Brave behöver en engångsbehörighetsfråga i Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从已安装的浏览器（Firefox、Chrome、Edge、Brave、Opera、Vivaldi、Chromium 及其 beta/nightly 版本）读取 Cookie。Chrome/Edge/Brave 需要一次 Windows 权限提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從已安裝的瀏覽器（Firefox、Chrome、Edge、Brave、Opera、Vivaldi、Chromium 及其 beta/nightly 版本）讀取 Cookie。Chrome/Edge/Brave 需要一次 Windows 權限提示。"
          }
        }
      }
    },
