          "stringUnit": {
            "state": "translated",
            "value": "直接媒體連結一律以原始格式儲存。"
          }
        }
      }
    },
    "Streaming plays in the BlindRSS player without saving.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Streamen wird im BlindRSS-Player abgespielt, ohne etwas zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción en streaming se realiza en el reproductor de BlindRSS sin guardar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture en streaming se fait dans le lecteur BlindRSS, sans rien enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रीमिंग BlindRSS प्लेयर में बिना सहेजे चलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo streaming viene riprodotto nel lettore di BlindRSS senza salvare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミング再生は保存せずに BlindRSS のプレーヤーで再生します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
