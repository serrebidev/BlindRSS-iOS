          }
        }
      }
    },
    "Feeds are checked by default.\nUncheck feeds that should not send notifications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeds sind standardmäßig aktiviert.\nDeaktivieren Sie Feeds, die keine Benachrichtigungen senden sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes están marcadas de forma predeterminada.\nDesmarque las fuentes que no deban enviar notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux sont cochés par défaut.\nDécochez les flux qui ne doivent pas envoyer de notifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ीड डिफ़ॉल्ट रूप से चेक की जाती हैं।\nजिन फ़ीड को सूचनाएं नहीं भेजनी चाहिए उन्हें अनचेक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I feed sono selezionati per impostazione predefinita.\nDeseleziona i feed che non devono inviare notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードは既定で選択されています。\n通知を送信しないフィードのチェックを外してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeds zijn standaard aangevinkt.\nVink feeds uit die geen meldingen mogen versturen."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeds zijn standaard aangevinkt.\nVink feeds uit die geen meldingen mogen versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanały są domyślnie zaznaczone.\nOdznacz kanały, które nie powinny wysyłać powiadomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os feeds são marcados por padrão.\nDesmarque os feeds que não devem enviar notificações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os feeds estão marcados por predefinição.\nDesmarque os feeds que não devem enviar notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каналы по умолчанию отмечены.\nСнимите флажки с каналов, которые не должны отправлять уведомления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flöden är markerade som standard.\nAvmarkera flöden som inte ska skicka aviseringar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅源默认已勾选。\n取消勾选不应发送通知的订阅源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱來源預設為已勾選。\n請取消勾選不應發送通知的訂閱來源。"
          }
        }
      }
    },
