        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस श्रेणी को हटाएं? फ़ीड \"अवर्गीकृत\" में ले जाए जाएंगे।"
          }
        },
        "it": {
          "stringUnit": {
