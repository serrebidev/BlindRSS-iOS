            "value": "Alt-Text von Bildern in Artikeln einschließen (kündigt Bilder an, kann pro Feed überschrieben werden)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir el texto alternativo de las imágenes en los artículos (anuncia las imágenes; se puede anular por fuente)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure le texte alternatif des images dans les articles (annonce les images, peut être remplacé par flux)"
          }
        },
        "hi": {
