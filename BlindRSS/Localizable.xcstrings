    "Using the Local RSS feed cache lowers CPU and network use. Manual Refresh All always checks every feed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung des Feed-Caches senkt die CPU- und Netzwerklast. Ein manuelles \"Alle aktualisieren\" prüft weiterhin jeden Feed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar la caché de fuentes reduce el uso de CPU y de red. La actualización manual de todas las fuentes siempre comprueba cada fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utilisation du cache des flux réduit l'utilisation du processeur et du réseau. L'actualisation manuelle de tous les flux vérifie toujours chaque flux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ीड कैश का उपयोग CPU और नेटवर्क उपयोग कम करता है। मैन्युअल रूप से सभी फ़ीड ताज़ा करने पर हमेशा हर फ़ीड की जाँच होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'uso della cache dei feed riduce l'uso di CPU e rete. L'aggiornamento manuale di tutti i feed controlla sempre ogni feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードキャッシュを使用すると CPU とネットワークの負荷が下がります。手動の「すべて更新」は常にすべてのフィードを確認します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gebruik van de feedcache verlaagt het CPU- en netwerkgebruik. Handmatig alles vernieuwen controleert altijd elke feed."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gebruik van de feedcache verlaagt het CPU- en netwerkgebruik. Handmatig alles vernieuwen controleert altijd elke feed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystanie z pamięci podręcznej kanałów zmniejsza obciążenie procesora i sieci. Ręczne odświeżenie wszystkich kanałów zawsze sprawdza każdy kanał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o cache de feeds reduz o uso de CPU e rede. Atualizar tudo manualmente sempre verifica cada feed."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar a cache de feeds reduz a utilização de CPU e rede. Atualizar tudo manualmente verifica sempre cada feed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование локального кэша RSS-каналов снижает нагрузку на процессор и сеть. Ручное обновление всех каналов всегда проверяет каждый канал."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att använda flödescachen minskar CPU- och nätverksanvändningen. Manuell uppdatering av alla flöden kontrollerar alltid varje flöde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用订阅源缓存可降低 CPU 和网络占用。手动刷新全部时始终会检查每个订阅源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用訂閱來源快取可降低 CPU 與網路使用量。手動重新整理全部時仍會檢查每個訂閱來源。"
          }
        }
      }
    },
