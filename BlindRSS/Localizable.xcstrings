    "Rokfin post is listed but not streamable right now: Rokfin returned an invalid playback ID for this post.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rokfin-Beitrag ist gelistet, aber derzeit nicht streambar: Rokfin hat eine ungültige Wiedergabe-ID für diesen Beitrag zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicación de Rokfin está listada pero no se puede reproducir ahora mismo: Rokfin devolvió un ID de reproducción no válido para esta publicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication Rokfin est référencée mais n'est pas diffusable pour le moment : Rokfin a renvoyé un identifiant de lecture non valide pour cette publication."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokfin पोस्ट सूचीबद्ध है लेकिन अभी स्ट्रीम नहीं हो सकती: Rokfin ने इस पोस्ट के लिए अमान्य प्लेबैक ID लौटाया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il post di Rokfin è elencato ma al momento non è riproducibile: Rokfin ha restituito un ID di riproduzione non valido per questo post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Rokfin の投稿は一覧に表示されていますが、現在は再生できません。Rokfin がこの投稿に対して無効な再生 ID を返しました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Rokfin-post staat vermeld maar is nu niet afspeelbaar: Rokfin gaf een ongeldig afspeel-ID terug voor deze post."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "De Rokfin-post staat vermeld maar is nu niet afspeelbaar: Rokfin gaf een ongeldig afspeel-ID terug voor deze post."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis Rokfin jest wymieniony, ale obecnie nie można go odtwarzać: Rokfin zwrócił nieprawidłowy identyfikator odtwarzania dla tego wpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A publicação do Rokfin está listada, mas não pode ser transmitida no momento: o Rokfin retornou um ID de reprodução inválido para esta publicação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A publicação do Rokfin está listada, mas não é transmissível neste momento: o Rokfin devolveu um ID de reprodução inválido para esta publicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись Rokfin есть в списке, но прямо сейчас недоступна для потокового воспроизведения: Rokfin вернул неверный идентификатор воспроизведения для этой записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokfin-inlägget är listat men kan inte strömmas just nu: Rokfin returnerade ett ogiltigt uppspelnings-ID för inlägget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 Rokfin 帖子已列出，但目前无法播放：Rokfin 为此帖子返回了无效的播放 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該 Rokfin 貼文已列出，但目前無法串流：Rokfin 為此貼文傳回了無效的播放 ID。"
          }
        }
      }
    },
