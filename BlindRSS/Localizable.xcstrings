        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć regułę filtrowania „{name}”? Artykuły już przez nią umieszczone nie zostaną zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir a regra de filtro \"{name}\"? Os artigos que ela já arquivou não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
