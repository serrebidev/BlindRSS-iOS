    "Categories can be expanded or collapsed. Use the buttons, or use Right Arrow to expand and Left Arrow to collapse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien können erweitert oder eingeklappt werden. Verwenden Sie die Schaltflächen oder die Pfeiltaste rechts zum Erweitern und die Pfeiltaste links zum Einklappen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías se pueden expandir o contraer. Use los botones, o la flecha derecha para expandir y la flecha izquierda para contraer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories peuvent être développées ou réduites. Utilisez les boutons, ou la flèche droite pour développer et la flèche gauche pour réduire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "श्रेणियों को विस्तृत या संक्षिप्त किया जा सकता है। बटन का उपयोग करें, या विस्तृत करने के लिए दायाँ तीर और संक्षिप्त करने के लिए बायाँ तीर दबाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie possono essere espanse o compresse. Usa i pulsanti, oppure la freccia destra per espandere e la freccia sinistra per comprimere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリは展開または折りたたむことができます。ボタンを使うか、右矢印キーで展開、左矢印キーで折りたたんでください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorieën kunnen worden uitgevouwen of samengevouwen. Gebruik de knoppen, of de pijl-rechts om uit te vouwen en pijl-links om samen te vouwen."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorieën kunnen worden uitgevouwen of samengevouwen. Gebruik de knoppen, of de pijl-rechts om uit te vouwen en pijl-links om samen te vouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie można rozwijać lub zwijać. Użyj przycisków albo strzałki w prawo, aby rozwinąć, i strzałki w lewo, aby zwinąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias podem ser expandidas ou recolhidas. Use os botões, ou a seta para a direita para expandir e a seta para a esquerda para recolher."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias podem ser expandidas ou recolhidas. Utilize os botões, ou a seta para a direita para expandir e a seta para a esquerda para recolher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории можно разворачивать или сворачивать. Используйте кнопки или используйте стрелку вправо, чтобы развернуть, и стрелку влево, чтобы свернуть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorier kan expanderas eller fällas ihop. Använd knapparna, eller högerpil för att expandera och vänsterpil för att fälla ihop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类可以展开或折叠。使用按钮,或按右箭头展开、左箭头折叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分類可以展開或摺疊。請使用按鈕,或按右方向鍵展開、左方向鍵摺疊。"
          }
        }
      }
    },
