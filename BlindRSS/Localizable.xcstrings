            "value": "Inkludera alt-text för bilder i artiklar (läser upp bilder, kan åsidosättas per flöde)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文章中包含图片替代文本(会朗读图片说明,可按订阅源单独设置)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
