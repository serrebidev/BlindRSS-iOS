    "This Google Group requires sign-in. Import its browser cookies with Tools > Import Site Cookies, then refresh the feed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Google-Gruppe erfordert eine Anmeldung. Importieren Sie ihre Browser-Cookies mit Extras > Website-Cookies importieren und aktualisieren Sie dann den Feed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo de Google requiere iniciar sesión. Importe sus cookies del navegador con Herramientas > Importar cookies del sitio y luego actualice la fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe Google nécessite une connexion. Importez ses cookies de navigateur avec Outils > Importer les cookies du site, puis actualisez le flux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Google समूह के लिए साइन-इन आवश्यक है। उपकरण > साइट कुकीज़ आयात करें से इसकी ब्राउज़र कुकीज़ आयात करें, फिर फ़ीड ताज़ा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gruppo Google richiede l'accesso. Importa i suoi cookie del browser con Strumenti > Importa cookie del sito, poi aggiorna il feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Google グループにはサインインが必要です。ツール > サイトの Cookie をインポート でブラウザーの Cookie をインポートしてから、フィードを更新してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Google Groep vereist aanmelding. Importeer de browsercookies via Extra > Sitecookies importeren en vernieuw daarna de feed."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Google Groep vereist aanmelding. Importeer de browsercookies via Extra > Sitecookies importeren en vernieuw daarna de feed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta grupa Google wymaga zalogowania. Zaimportuj jej pliki cookie przeglądarki za pomocą Narzędzia > Importuj pliki cookie witryny, a następnie odśwież kanał."
          }
        },
