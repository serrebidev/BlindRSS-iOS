        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新メタデータをダウンロードできませんでした。GitHub が一時的に利用できない可能性があります。数分後にもう一度お試しください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan updategegevens niet downloaden. GitHub is mogelijk tijdelijk niet bereikbaar; probeer het over een paar minuten opnieuw."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan updategegevens niet downloaden. GitHub is mogelijk tijdelijk niet bereikbaar; probeer het over een paar minuten opnieuw."
