    "Article formatting: preserve structure from the original page as spoken text markers. Applies to newly loaded articles and full text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikelformatierung: Struktur der Originalseite als gesprochene Textmarkierungen erhalten. Gilt für neu geladene Artikel und Volltext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato del artículo: conservar la estructura de la página original como marcadores de texto hablados. Se aplica a los artículos recién cargados y al texto completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise en forme des articles : conserver la structure de la page d'origine sous forme de marqueurs textuels parlés. S'applique aux articles nouvellement chargés et au texte intégral."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेख स्वरूपण: मूल पृष्ठ की संरचना को बोले जाने वाले पाठ चिह्नों के रूप में सुरक्षित रखें। नए लोड किए गए लेखों और पूर्ण पाठ पर लागू होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formattazione degli articoli: conserva la struttura della pagina originale come indicatori testuali letti ad alta voce. Si applica agli articoli appena caricati e al testo completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事の書式: 元のページの構造を読み上げ用テキストマーカーとして保持します。新しく読み込まれた記事と全文に適用されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikelopmaak: structuur van de oorspronkelijke pagina behouden als gesproken tekstmarkeringen. Geldt voor nieuw geladen artikelen en volledige tekst."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikelopmaak: structuur van de oorspronkelijke pagina behouden als gesproken tekstmarkeringen. Geldt voor nieuw geladen artikelen en volledige tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatowanie artykułów: zachowuj strukturę oryginalnej strony jako wypowiadane znaczniki tekstowe. Dotyczy nowo wczytanych artykułów i pełnego tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatação de artigos: preservar a estrutura da página original como marcadores de texto falados. Aplica-se a artigos recém-carregados e ao texto completo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatação de artigos: preservar a estrutura da página original como marcadores de texto falados. Aplica-se a artigos recém-carregados e ao texto completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форматирование статьи: сохранять структуру исходной страницы в виде произносимых текстовых обозначений. Применяется к вновь загруженным статьям и полному тексту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikelformatering: bevara strukturen från originalsidan som upplästa textmarkörer. Gäller nyinlästa artiklar och fulltext."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文章格式：将原始页面的结构保留为朗读文本标记。适用于新加载的文章和全文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文章格式：將原始頁面的結構保留為朗讀文字標記。適用於新載入的文章和全文。"
          }
        }
      }
    },
