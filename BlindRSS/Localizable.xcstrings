          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamen speelt af in de BlindRSS-speler zonder iets op te slaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie strumieniowe odbywa się w odtwarzaczu BlindRSS bez zapisywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O streaming é reproduzido no reprodutor do BlindRSS sem salvar nada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O streaming é reproduzido no reprodutor do BlindRSS sem guardar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потоковое воспроизведение выполняется в проигрывателе BlindRSS без сохранения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömning spelas upp i BlindRSS-spelaren utan att sparas."
          }
        },
        "zh-Hans": {
