    "Delete filter rule \"{name}\"? Articles it already filed are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterregel „{name}“ löschen? Bereits einsortierte Artikel werden dadurch nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar la regla de filtro \"{name}\"? Los artículos que ya archivó no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la règle de filtrage « {name} » ? Les articles déjà classés par celle-ci ne sont pas modifiés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्टर नियम \"{name}\" हटाएं? यह जिन लेखों को पहले ही फ़ाइल कर चुका है वे नहीं बदलेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare la regola di filtro \"{name}\"? Gli articoli già archiviati non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタールール「{name}」を削除しますか? すでに処理済みの記事は変更されません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterregel \"{name}\" verwijderen? Artikelen die er al door zijn ingedeeld, worden niet gewijzigd."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterregel \"{name}\" verwijderen? Artikelen die er al door zijn ingedeeld, worden niet gewijzigd."
