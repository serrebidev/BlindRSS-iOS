    "Run all enabled rules against every existing article now? This may move, label, or delete articles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt alle aktivierten Regeln auf alle vorhandenen Artikel anwenden? Dies kann Artikel verschieben, kennzeichnen oder löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ejecutar ahora todas las reglas habilitadas sobre cada artículo existente? Esto puede mover, etiquetar o eliminar artículos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter maintenant toutes les règles activées sur chaque article existant ? Cela peut déplacer, étiqueter ou supprimer des articles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या अभी सभी सक्षम नियमों को हर मौजूदा लेख पर चलाना है? इससे लेख स्थानांतरित, लेबल या हटाए जा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguire ora tutte le regole abilitate su ogni articolo esistente? Questo potrebbe spostare, etichettare o eliminare articoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なすべてのルールを、既存のすべての記事に対して今すぐ実行しますか? これにより記事が移動、ラベル付け、削除される場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu alle ingeschakelde regels uitvoeren op elk bestaand artikel? Dit kan artikelen verplaatsen, labelen of verwijderen."
          }
        },
        "nl-BE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu alle ingeschakelde regels uitvoeren op elk bestaand artikel? Dit kan artikelen verplaatsen, labelen of verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchomić teraz wszystkie włączone reguły dla każdego istniejącego artykułu? Może to spowodować przeniesienie, oznaczenie etykietą lub usunięcie artykułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar agora todas as regras habilitadas em cada artigo existente? Isso pode mover, rotular ou excluir artigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar agora todas as regras ativadas em cada artigo existente? Isto pode mover, rotular ou eliminar artigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить все включённые правила для каждой существующей статьи прямо сейчас? Это может привести к перемещению, установке метки или удалению статей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köra alla aktiverade regler mot alla befintliga artiklar nu? Detta kan flytta, märka eller ta bort artiklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否立即对每篇现有文章运行所有已启用的规则?这可能会移动、加注标签或删除文章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要立即對每篇現有文章執行所有已啟用的規則嗎?這可能會移動、標記或刪除文章。"
          }
        }
      }
    },
