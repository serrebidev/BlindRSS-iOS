    "Auto-update is only available in the packaged app build.\nDownload the latest release from GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Updates sind nur im gepackten App-Build verfügbar.\nLaden Sie die neueste Version von GitHub herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
