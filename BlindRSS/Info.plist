<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.serrebidev.BlindRSS.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<!-- A declared launch screen is what opts the app into the device's
	     native resolution. Without one, iOS runs the app in a scaled
	     compatibility canvas and it never fills the screen (letterboxed
	     on iPhone 17 Pro and every other current size). -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>BlindRSS uses the local network to find Chromecast and Google TV devices for Google Cast playback.</string>
	<!-- The open article, for Siri onscreen awareness (ArticleReaderView). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>org.serrebidev.BlindRSS.article</string>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>BlindRSS transcribes news videos on this device, so articles that are only a video can be read as text.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
	</array>
</dict>
</plist>
